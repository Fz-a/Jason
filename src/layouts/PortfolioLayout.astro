---
import FloatingControls from "@/components/controls/FloatingControls.astro";
import Layout from "./Layout.astro";

interface Props {
	title?: string;
	description?: string;
	lang?: string;
}

const { title, description, lang } = Astro.props;
---

<Layout title={title} description={description} lang={lang} hasWallpaper={false} noBanner={true}>
	{/*
	  Swup 要求配置里的每个 container 在所有页面都存在。
	  作品集布局没有侧栏/Banner，用隐藏占位满足替换，避免整页硬刷新。
	*/}
	<div id="banner-overlay-container" class="hidden" aria-hidden="true"></div>
	<div id="banner-dim-container" class="hidden" aria-hidden="true"></div>
	<div id="left-sidebar-dynamic" class="hidden" aria-hidden="true"></div>
	<div id="right-sidebar-dynamic" class="hidden" aria-hidden="true"></div>
	<div id="floating-toc-wrapper" class="hidden" aria-hidden="true"></div>

	<div id="portfolio-shell" class="folio-shell relative z-20 w-full mx-auto">
		<main id="swup-container" class="transition-swup-fade pb-8">
			<slot />
		</main>
	</div>

	<FloatingControls />
</Layout>

<style is:global>
	.folio-shell {
		max-width: 78rem;
		padding-left: max(0.75rem, env(safe-area-inset-left, 0px));
		padding-right: max(0.75rem, env(safe-area-inset-right, 0px));
		padding-top: max(1.15rem, env(safe-area-inset-top, 0px));
		padding-bottom: env(safe-area-inset-bottom, 0px);
		box-sizing: border-box;
	}

	@media (min-width: 640px) {
		.folio-shell {
			padding-left: max(1.25rem, env(safe-area-inset-left, 0px));
			padding-right: max(1.25rem, env(safe-area-inset-right, 0px));
		}
	}

	@media (min-width: 768px) {
		.folio-shell {
			padding-left: max(1.5rem, env(safe-area-inset-left, 0px));
			padding-right: max(1.5rem, env(safe-area-inset-right, 0px));
			padding-top: max(1.5rem, env(safe-area-inset-top, 0px));
		}
	}

	body:has(.folio-shell) #progress-bar {
		opacity: 0.35;
	}

	/* Swup 切页：保持内容可见，避免整块淡出到黑底造成频闪 */
	html.is-changing body:has(.folio-shell) .transition-swup-fade,
	html.is-animating body:has(.folio-shell) .transition-swup-fade,
	html.is-leaving body:has(.folio-shell) .transition-swup-fade {
		opacity: 1 !important;
		transform: none !important;
		transition: none !important;
	}

	/* 站内导航期间跳过入场动画与影子戏/毛笔字动画 */
	html.folio-nav .folio-tile,
	html.folio-nav .folio-tree-stage,
	html.folio-nav .folio-char,
	html.folio-nav .folio-brush-line,
	html.folio-nav .folio-hero .folio-cloud {
		animation: none !important;
		transition: none !important;
		opacity: 1 !important;
		transform: none !important;
		filter: none !important;
	}

	html.folio-nav .folio-hero {
		/* 立刻视为已揭示，避免字先隐后显 */
	}

	/* Masthead — keep in layout so Swup updateHead always has the latest rules */
	.folio-mast {
		display: grid !important;
		gap: 0.7rem !important;
		padding: 0.1rem 0 0.2rem !important;
		margin: 0 0 0.35rem !important;
		border: 0 !important;
		border-radius: 0 !important;
		background: transparent !important;
		box-shadow: none !important;
		min-height: 0 !important;
		overflow: visible !important;
	}
	.folio-mast-row {
		display: flex !important;
		align-items: flex-end !important;
		gap: clamp(0.75rem, 1.8vw, 1.1rem) !important;
	}
	.folio-mast-main {
		min-width: 0;
		flex: 1;
		display: grid;
		gap: 0.28rem;
	}
	.folio-mast-title-row {
		display: flex !important;
		align-items: baseline !important;
		justify-content: space-between !important;
		gap: 1rem !important;
		min-width: 0;
	}
	.folio-mast-mark {
		position: relative !important;
		inset: auto !important;
		right: auto !important;
		top: auto !important;
		translate: none !important;
		rotate: 0deg !important;
		flex-shrink: 0;
		width: 0.22rem !important;
		height: clamp(2.4rem, 5vw, 3.1rem) !important;
		margin: 0 0 0.2rem !important;
		border: 0 !important;
		border-radius: 1px !important;
		background: linear-gradient(180deg, rgb(139 58 58 / 0.85), rgb(139 58 58 / 0.35)) !important;
		color: transparent !important;
		font-size: 0 !important;
		opacity: 1 !important;
	}
	.folio-mast-rule {
		height: 1px;
		width: 100%;
		background: linear-gradient(90deg, rgb(42 38 32 / 0.32), rgb(42 38 32 / 0.14) 38%, rgb(42 38 32 / 0.04));
	}
	.folio-mast-meta {
		display: inline-flex !important;
		align-items: baseline;
		gap: 0.3rem;
		margin: 0;
		padding: 0 0 0.15rem;
	}
	.folio-mast-count {
		font-variant-numeric: tabular-nums;
		font-size: clamp(0.95rem, 1.7vw, 1.1rem);
		font-weight: 550;
		letter-spacing: 0.08em;
		color: rgb(26 24 20 / 0.45);
		font-family: var(--folio-font-typewriter, "Courier New", monospace);
	}
	.folio-mast-count-label {
		font-size: 0.68rem;
		letter-spacing: 0.16em;
		color: rgb(26 24 20 / 0.34);
	}
	.folio-mast-kicker {
		margin: 0;
		font-size: 0.66rem;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: rgb(26 24 20 / 0.36);
	}
</style>

<script is:inline>
	(() => {
		const html = document.documentElement;

		function markNav() {
			html.classList.add("folio-nav");
			html.classList.remove("folio-enter");
		}

		function clearNav() {
			requestAnimationFrame(() => {
				requestAnimationFrame(() => {
					html.classList.remove("folio-nav");
				});
			});
		}

		function bootEnter() {
			if (html.dataset.folioBooted) return;
			html.dataset.folioBooted = "1";
			if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
			html.classList.add("folio-enter");
			window.setTimeout(() => html.classList.remove("folio-enter"), 450);
		}

		function isFolioSectionUrl(raw) {
			try {
				const path = new URL(raw, window.location.origin).pathname.replace(/\/+$/, "") || "/";
				return /^\/(knowledge|projects|works|life|music)(\/|$)/.test(path + "/");
			} catch {
				return false;
			}
		}

		function bustFolioCache(swup, visit) {
			const to = visit?.to?.url;
			if (!to || !isFolioSectionUrl(to)) return;
			// Avoid stale SSR shells (old banner markup/CSS) after design changes
			try {
				visit.meta = visit.meta || {};
				visit.meta.cache = false;
			} catch {
				/* ignore */
			}
			try {
				swup.cache?.delete?.(to);
				const alt = to.endsWith("/") ? to.slice(0, -1) : `${to}/`;
				swup.cache?.delete?.(alt);
			} catch {
				/* ignore */
			}
		}

		function bind(swup) {
			if (!swup?.hooks || html.dataset.folioSwupBound) return;
			html.dataset.folioSwupBound = "1";
			swup.hooks.on("visit:start", (visit) => {
				markNav();
				bustFolioCache(swup, visit);
			});
			swup.hooks.on("content:replace", markNav);
			swup.hooks.on("page:view", clearNav);
			swup.hooks.on("animation:in:end", clearNav);
		}

		bootEnter();
		if (window.swup) bind(window.swup);
		document.addEventListener("swup:enable", () => bind(window.swup));
	})();
</script>
