---
import FloatingButton from "@/components/common/FloatingButton.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { url } from "@/utils/url-utils";
---

<FloatingButton
	id="back-to-home-btn"
	icon="material-symbols:home-outline-rounded"
	ariaLabel={i18n(I18nKey.home)}
	onclick="backToHome()"
	class="hide folio-nav-fab folio-nav-fab-home"
/>

<script is:inline define:vars={{ homeUrl: url("/") }}>
	window.backToHome = function () {
		if (window.swup) window.swup.navigate(homeUrl);
		else window.location.href = homeUrl;
	};
</script>
