# 复制本文件为 mirror.env（同目录），按你的网络环境修改。
# mirror.env 已在 .gitignore，不会提交到 GitHub。
#
# 用法：
#   copy scripts\mirror.env.example scripts\mirror.env
#   然后改端口 / 代理地址，再双击 推送.bat

# ---- Git / GitHub（HTTPS 推送、API 查询）----
# Clash / v2rayN 等常见本地代理端口（自行核对）
HTTPS_PROXY=http://127.0.0.1:7897
HTTP_PROXY=http://127.0.0.1:7897
GIT_HTTPS_PROXY=http://127.0.0.1:7897
GIT_HTTP_PROXY=http://127.0.0.1:7897

# ---- npm / 构建 techfolio ----
NPM_CONFIG_REGISTRY=https://registry.npmmirror.com

# ---- 可选：探测不到 mirror.env 时，是否自动尝试 127.0.0.1:7897 ----
# AUTO_PROBE_PROXY=1
