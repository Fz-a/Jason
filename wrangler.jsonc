{
	"name": "firefly",
	"compatibility_date": "2025-01-01",
	"compatibility_flags": ["nodejs_compat"],
	"pages_build_output_dir": "dist",
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "jason-folio-cms",
			"database_id": "00000000-0000-0000-0000-000000000001",
			"migrations_dir": "migrations"
		}
	],
	// R2 (MEDIA) is bound in the Cloudflare dashboard after enabling R2.
	// Declaring r2_buckets here makes `wrangler deploy` fail with code 10042
	// when R2 is not enabled on the account.
	"vars": {
		"CMS_ADMIN_USERNAME": "admin"
	}
}
